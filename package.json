{
  "name": "gazra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-gazra \"node --test tests/firestore.rules.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run test:rules && npm run test:e2e",
    "publish:vadvarso": "node scripts/publish-vadvarso-blog-series.mjs",
    "preview": "next start",
    "deploy": "npm run build",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:backend": "firebase deploy --only functions && firebase deploy --only firestore:rules,firestore:indexes,storage,database",
    "deploy:all": "npm run deploy:backend && npm run build",
    "start": "next start",
    "deploy:hosting": "echo \"Next.js hosting target is not configured yet. Use Firebase App Hosting or another SSR deployment target.\" && exit 1"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^1.0.6",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.15",
    "firebase": "^12.6.0",
    "framer-motion": "^11.11.11",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.454.0",
    "next": "^16.2.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.5.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@netlify/plugin-nextjs": "^5.15.11",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "firebase-tools": "^15.1.0",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
