rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    
    // Public read access for all files
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Authenticated users can upload to specific folders
    match /events/{fileName} {
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024;
    }

    match /eventLocations/{fileName} {
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024;
    }
    
    match /gallery/{fileName} {
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024;
    }
    
    match /menu/{fileName} {
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024;
    }

    match /cafeMoments/{fileName} {
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024;
    }

    match /testimonials/{fileName} {
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024;
    }

    match /instagram/{fileName} {
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024;
    }
    
    match /initiatives/{fileName} {
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
