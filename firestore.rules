rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Public read access for events, menu items, and initiatives
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /eventLocations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /eventLocationBookings/{bookingId} {
      allow read, write: if isAdmin();
    }

    match /eventLocationSlots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Cafe collections - public read, authenticated write
    match /cafeFeatures/{featureId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cafeTestimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cafeSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cafeInstagram/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cafeMoments/{momentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Cafe bookings - allow create for anyone, read/update/delete for authenticated users
    match /cafeBookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Cafe closed dates - public read, authenticated write
    match /cafeClosedDates/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /initiatives/{initiativeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Form submissions - allow create for anyone, read/update/delete for authenticated users
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /volunteers/{volunteerId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /supportRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /newsletter/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /eventRsvps/{rsvpId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /mailQueue/{mailId} {
      allow read, write: if isAdmin();
    }
    
    // Skills courses - public read, authenticated write
    match /skillsCourses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Skills enrollments - allow create for anyone, read/update/delete for authenticated users
    match /skillsEnrollments/{enrollmentId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Admin-only collections
    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow list, write: if isAdmin();
    }
  }
}
